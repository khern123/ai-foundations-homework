# Copy this file to .env and fill in real values. Never commit .env.

# ---- Backend (FastAPI) ----
APP_ENV=development
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Optional: use a different SQLite file (the tests point this at a throwaway copy).
# DATABASE_PATH=
# Chat agent (OpenAI via Portkey). Server-side only.
# If left blank, the backend falls back to PORTKEY_API_KEY in the nearest parent .env
# (e.g. the shared AI Foundations/.env), so the key doesn't need to be copied here.
PORTKEY_API_KEY=
# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# ---- Frontend (Vite) ----
# Anything prefixed with VITE_ is bundled into browser code and is PUBLIC.
# Never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:8000

# Signs login session tokens. Any long random string; keep it secret. If blank, a random one is used per
# server start (everyone is logged out on restart).
SESSION_SECRET=
